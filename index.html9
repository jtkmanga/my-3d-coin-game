<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Voxel World 3D</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Kanit', sans-serif; user-select: none; touch-action: manipulation; }
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #0f172a; }
        #game-canvas { width: 100%; height: 100%; display: block; }
        .joystick-container { position: absolute; bottom: 30px; left: 30px; width: 120px; height: 120px; background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px); border: 2px solid rgba(255, 255, 255, 0.3); border-radius: 50%; touch-action: none; z-index: 20; }
        .joystick-handle { position: absolute; top: 50%; left: 50%; width: 50px; height: 50px; background: linear-gradient(135deg, #f59e0b, #d97706); border: 2px solid #ffffff; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
        .name-tag { position: absolute; transform: translate(-50%, -100%); background: rgba(15, 23, 42, 0.85); border: 1.5px solid #f59e0b; color: #ffffff; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 700; white-space: nowrap; pointer-events: none; z-index: 10; display: flex; align-items: center; gap: 6px; }
    </style>
</head>
<body class="relative">

    <canvas id="game-canvas"></canvas>

    <div id="player-nametag" class="name-tag hidden">
        <i class="fa-solid fa-crown text-amber-400 text-xs"></i>
        <span id="nametag-text">Player</span>
    </div>

    <!-- START SCREEN -->
    <div id="start-screen" class="absolute inset-0 z-50 flex items-center justify-center bg-slate-950/90 backdrop-blur-md p-4">
        <div class="max-w-md w-full bg-slate-900 border-2 border-amber-500/40 rounded-3xl p-6 text-center shadow-2xl relative overflow-hidden">
            <div class="mb-6">
                <h1 class="text-4xl font-extrabold text-amber-500 uppercase tracking-wider">VOXEL WORLD 3D</h1>
                <p class="text-slate-400 text-xs mt-1">เกมเก็บเหรียญออนไลน์สามมิติ</p>
            </div>

            <div class="space-y-4">
                <button id="btn-google-login" onclick="handleGoogleLogin()" class="w-full flex items-center justify-center gap-3 bg-white hover:bg-slate-100 text-slate-800 font-bold py-3.5 px-4 rounded-xl shadow-lg transition active:scale-95">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>เข้าสู่ระบบด้วย Google</span>
                </button>

                <div id="user-profile-info" class="hidden bg-slate-800 p-4 rounded-2xl border border-slate-700 flex items-center gap-3">
                    <img id="user-avatar" src="" class="w-10 h-10 rounded-full border-2 border-amber-400" alt="Avatar">
                    <div class="text-left flex-1 min-w-0">
                        <div id="user-email" class="text-xs text-amber-400 font-semibold truncate"></div>
                        <div class="text-[10px] text-slate-400">เข้าสู่ระบบแล้ว</div>
                    </div>
                    <button onclick="handleLogout()" class="text-xs text-rose-400 font-semibold px-2 py-1">ออก</button>
                </div>

                <div class="text-left">
                    <label class="block text-xs font-semibold text-slate-300 mb-1">ชื่อผู้เล่น</label>
                    <input type="text" id="input-username" placeholder="กรอกชื่อ..." maxlength="12" class="w-full bg-slate-800 border border-slate-700 text-white rounded-xl px-4 py-3 focus:outline-none focus:border-amber-500 text-sm font-semibold">
                </div>

                <button id="btn-start-game" onclick="startGame()" class="w-full bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-white font-extrabold py-3.5 px-6 rounded-xl shadow-lg text-lg active:scale-95 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>เริ่มเล่นเกม</span>
                </button>
            </div>
        </div>
    </div>

    <!-- HUD -->
    <div id="game-hud" class="absolute inset-0 z-30 pointer-events-none hidden flex flex-col justify-between p-4">
        <div class="flex items-center justify-between w-full pointer-events-auto">
            <div class="bg-slate-900/90 border border-amber-500/60 text-white px-4 py-2 rounded-2xl flex items-center gap-3 shadow-lg">
                <i class="fa-solid fa-coins text-amber-400 text-xl"></i>
                <div>
                    <div class="text-[10px] text-amber-300 uppercase font-semibold">คะแนน</div>
                    <div id="hud-score" class="text-lg font-extrabold text-amber-400 leading-none">0</div>
                </div>
            </div>

            <div id="mini-leaderboard" class="bg-slate-900/90 border border-amber-500/60 rounded-2xl p-3 w-44 text-white text-xs space-y-1">
                <div class="font-bold text-amber-400 border-b border-slate-700 pb-1 mb-1">Top Scores</div>
                <div id="leaderboard-items" class="space-y-1"></div>
            </div>
        </div>

        <div class="relative w-full h-full pointer-events-none">
            <div id="btn-jump" class="absolute bottom-8 right-8 w-20 h-20 bg-amber-500 border-4 border-white text-white font-bold rounded-full flex items-center justify-center text-2xl active:scale-90 pointer-events-auto shadow-xl">
                <i class="fa-solid fa-arrow-up"></i>
            </div>
        </div>
    </div>

    <!-- FIREBASE & GAME SCRIPT -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, GoogleAuthProvider, signInWithRedirect, getRedirectResult, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getDatabase, ref, set, get, child, update, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyCwn4rJ48I_bsVI2Ez59szQJubShvhO1SE",
            authDomain: "lucky-game-6936b.firebaseapp.com",
            databaseURL: "https://lucky-game-6936b-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "lucky-game-6936b",
            storageBucket: "lucky-game-6936b.firebasestorage.app",
            messagingSenderId: "541211602508",
            appId: "1:541211602508:web:b41b55fb5462269fbc4ee9"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getDatabase(app);

        window.state = {
            playerName: "Player",
            score: 0,
            currentUser: null,
            highScore: 0,
            isPlaying: false
        };

        // Check Redirect Result
        getRedirectResult(auth).catch((error) => {
            console.error("Login Redirect Error:", error);
        });

        // Listen for Auth State
        onAuthStateChanged(auth, async (user) => {
            if (user) {
                state.currentUser = user;
                state.playerName = user.displayName || user.email.split('@')[0];

                document.getElementById('user-email').innerText = user.email;
                document.getElementById('user-avatar').src = user.photoURL || 'https://via.placeholder.com/100';
                document.getElementById('input-username').value = state.playerName;

                document.getElementById('btn-google-login').classList.add('hidden');
                document.getElementById('user-profile-info').classList.remove('hidden');

                const snap = await get(child(ref(db), `users/${user.uid}`));
                if (snap.exists()) {
                    state.highScore = snap.val().highScore || 0;
                } else {
                    await set(ref(db, `users/${user.uid}`), {
                        email: user.email,
                        name: state.playerName,
                        highScore: 0
                    });
                }
            } else {
                state.currentUser = null;
                document.getElementById('btn-google-login').classList.remove('hidden');
                document.getElementById('user-profile-info').classList.add('hidden');
            }
        });

        // Realtime Leaderboard
        onValue(ref(db, 'users'), (snapshot) => {
            if (snapshot.exists()) {
                const data = snapshot.val();
                const list = [];
                Object.keys(data).forEach(uid => {
                    if (data[uid].name) {
                        list.push({ name: data[uid].name, score: data[uid].highScore || 0 });
                    }
                });
                list.sort((a, b) => b.score - a.score);
                
                const container = document.getElementById('leaderboard-items');
                container.innerHTML = '';
                list.slice(0, 5).forEach((item, index) => {
                    const div = document.createElement('div');
                    div.className = 'flex justify-between items-center';
                    div.innerHTML = `<span class="truncate">${index+1}. ${item.name}</span><span class="font-bold text-amber-400 ml-1">${item.score}</span>`;
                    container.appendChild(div);
                });
            }
        });

        window.handleGoogleLogin = function() {
            const provider = new GoogleAuthProvider();
            signInWithRedirect(auth, provider);
        };

        window.handleLogout = function() {
            signOut(auth);
        };

        window.startGame = function() {
            const nameInput = document.getElementById('input-username').value.trim();
            if (nameInput) state.playerName = nameInput;

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-hud').classList.remove('hidden');
            document.getElementById('player-nametag').classList.remove('hidden');
            document.getElementById('nametag-text').innerText = state.playerName;

            state.isPlaying = true;
            if (!scene) init3D();
        };

        // THREE.JS SIMPLE GAME ENGINE
        let scene, camera, renderer, playerGroup, coins = [];
        const playerPos = new THREE.Vector3(0, 0, 0);

        function init3D() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0f172a);

            camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('game-canvas'), antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);

            const light = new THREE.DirectionalLight(0xffffff, 1);
            light.position.set(10, 20, 10);
            scene.add(light);
            scene.add(new THREE.AmbientLight(0xffffff, 0.6));

            // Floor
            const floor = new THREE.Mesh(new THREE.BoxGeometry(200, 1, 200), new THREE.MeshLambertMaterial({ color: 0x334155 }));
            floor.position.y = -0.5;
            scene.add(floor);

            // Player Cube
            playerGroup = new THREE.Mesh(new THREE.BoxGeometry(1.5, 2, 1.5), new THREE.MeshLambertMaterial({ color: 0xf59e0b }));
            scene.add(playerGroup);

            // Spawn Coins
            const coinGeo = new THREE.CylinderGeometry(0.5, 0.5, 0.2, 16);
            const coinMat = new THREE.MeshStandardMaterial({ color: 0xfacc15, metalness: 0.8 });
            for (let i = 0; i < 30; i++) {
                const coin = new THREE.Mesh(coinGeo, coinMat);
                coin.rotation.x = Math.PI / 2;
                coin.position.set((Math.random() - 0.5) * 160, 1, (Math.random() - 0.5) * 160);
                scene.add(coin);
                coins.push(coin);
            }

            animate();
        }

        function animate() {
            requestAnimationFrame(animate);
            if (!state.isPlaying) return;

            // Rotate coins & check collision
            coins.forEach(coin => {
                if (coin.visible) {
                    coin.rotation.z += 0.05;
                    if (playerPos.distanceTo(coin.position) < 2) {
                        coin.visible = false;
                        state.score += 100;
                        document.getElementById('hud-score').innerText = state.score;

                        // Save highscore
                        if (state.currentUser && state.score > state.highScore) {
                            state.highScore = state.score;
                            update(ref(db, `users/${state.currentUser.uid}`), {
                                name: state.playerName,
                                highScore: state.score
                            });
                        }
                    }
                }
            });

            // Camera Follow
            camera.position.set(playerPos.x, playerPos.y + 10, playerPos.z + 15);
            camera.lookAt(playerPos);

            // Update Nametag
            const tempVec = new THREE.Vector3(playerPos.x, playerPos.y + 2.5, playerPos.z);
            tempVec.project(camera);
            const x = (tempVec.x * 0.5 + 0.5) * window.innerWidth;
            const y = (-(tempVec.y * 0.5) + 0.5) * window.innerHeight;
            const tag = document.getElementById('player-nametag');
            tag.style.left = `${x}px`;
            tag.style.top = `${y}px`;

            renderer.render(scene, camera);
        }
    </script>
</body>
</html>